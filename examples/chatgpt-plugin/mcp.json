{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "stitch": {
      "type": "streamable-http",
      "url": "https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "stitch",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
