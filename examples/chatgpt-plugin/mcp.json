{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "stitch": {
      "type": "streamable-http",
      "url": "https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "api_key",
            "headerScheme": "custom_header",
            "headerName": "X-Goog-Api-Key"
          }
        }
      }
    }
  }
}
